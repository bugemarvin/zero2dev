{
  "title": "Tokens in their own file",
  "lesson": "scss/03-modules",
  "kind": "web",
  "workspace": "sass",
  "page": "index.html",
  "compile": {
    "style.scss": "style.css"
  },
  "edit": [
    "style.scss",
    "_tokens.scss"
  ],
  "timeout": 120,
  "checks": [
    {
      "name": "the tokens file declares the three variables",
      "source": "_tokens.scss",
      "contains": [
        "$brand:",
        "$text:",
        "$space:"
      ]
    },
    {
      "name": "style.scss loads the tokens with @use",
      "source": "style.scss",
      "regex": "@use\\s+[\\\"']tokens[\\\"']",
      "fail": "Start style.scss with: @use \"tokens\";"
    },
    {
      "name": "style.scss does not use @import",
      "source": "style.scss",
      "not_contains": [
        "@import"
      ]
    },
    {
      "name": "the values live only in the tokens file",
      "source": "style.scss",
      "not_contains": [
        "#1a73e8",
        "#222222",
        "16px"
      ]
    },
    {
      "name": "body text has the text colour",
      "select": "body",
      "style": {
        "color": "#222222"
      }
    },
    {
      "name": "the h1 has the brand colour and the space below",
      "select": "h1",
      "style": {
        "color": "#1a73e8",
        "margin-bottom": "16px"
      }
    },
    {
      "name": ".button has the brand background and white text",
      "select": ".button",
      "style": {
        "background-color": "#1a73e8",
        "color": "white"
      }
    },
    {
      "name": ".button has 8px vertical and 16px horizontal padding",
      "select": ".button",
      "style": {
        "padding-top": "8px",
        "padding-bottom": "8px",
        "padding-left": "16px",
        "padding-right": "16px"
      }
    },
    {
      "name": "the half is calculated with math.div",
      "source": "style.scss",
      "contains": [
        "sass:math",
        "math.div("
      ]
    }
  ],
  "hints": [
    "The first two lines of style.scss: @use \"sass:math\"; and @use \"tokens\";",
    "A variable of another file needs its namespace: color: tokens.$brand;",
    "padding: math.div(tokens.$space, 2) tokens.$space; gives 8px 16px."
  ]
}
