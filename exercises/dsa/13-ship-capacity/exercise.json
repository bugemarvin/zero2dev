    {
      "name": "one package",
      "stdin": "1 1\n7\n",
      "stdout": "7\n"
    },
    {
      "name": "100,000 packages",
      "stdin_py": "'100000 1000\\n' + ' '.join(str((i * 37) % 500 + 1) for i in range(100000)) + '\\n'",
      "stdout": "25185\n"
