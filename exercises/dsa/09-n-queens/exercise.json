  "hints": [
    "One queen per row means you only choose a column for each row.",
    "Two squares are on the same diagonal when row - col is equal, or when row + col is equal.",
    "Keep three sets: used columns, used row - col values and used row + col values. Remove from them when you backtrack."
  ]
