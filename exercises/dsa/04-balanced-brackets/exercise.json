      "stdout": "yes\nno\n"
    }
  ],
  "hints": [
    "Push each opening bracket on a stack.",
    "For a closing bracket, the stack must not be empty and its top must be the matching opener.",
    "At the end the stack must be empty, or something was never closed."
  ]
}
