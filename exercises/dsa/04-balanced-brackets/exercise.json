{
  "title": "Balanced brackets",
  "lesson": "dsa/04-stacks-and-queues",
  "kind": "program",
  "lang": "any",
  "cases": [
    {
      "name": "simple cases",
      "stdin": "4\n{[()]}\n([)]\n((\na[i]=(b+c)\n",
      "stdout": "yes\nno\nno\nyes\n"
    },
    {
      "name": "a closing bracket with nothing open",
      "stdin": "3\n)\n())\n]x[\n",
      "stdout": "no\nno\nno\n"
    },
    {
      "name": "left open at the end",
      "stdin": "3\n(()\n{[]\n[\n",
      "stdout": "no\nno\nno\n"
    },
    {
      "name": "no brackets at all is balanced",
      "stdin": "2\nhello\nx+y\n",
      "stdout": "yes\nyes\n"
    },
    {
      "name": "wrong kind of closer",
      "stdin": "3\n(]\n{)\n[}\n",
      "stdout": "no\nno\nno\n"
    },
    {
      "name": "deep nesting",
