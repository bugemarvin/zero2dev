{
  "title": "Update the stock",
  "lesson": "mongodb/03-updates",
  "kind": "mongo",
  "timeout": 60,
  "seed": "seed.js",
  "require": [
    "$inc",
    "$addToSet",
    "$pull",
    "upsert"
  ],
  "checks": [
    {
      "name": "book 1 has one copy less in the shop",
      "eval": "db.books.findOne({ _id: 1 }).stock",
      "expect": {
        "shop": 3,
        "warehouse": 20
      }
    },
    {
      "name": "the classics cost 2 more",
      "eval": "db.books.find({ _id: { $in: [1, 3, 4, 6] } }, { price: 1 }).sort({ _id: 1 }).toArray().map((b) => b.price)",
      "expect": [
        14.5,
        9.25,
        12.0,
        10.5
      ]
    },
    {
      "name": "the other prices are unchanged",
      "eval": "db.books.find({ _id: { $in: [2, 5, 8] } }, { price: 1 }).sort({ _id: 1 }).toArray().map((b) => b.price)",
      "expect": [
        9.0,
        14.0,
        15.5
      ]
    },
    {
      "name": "book 8 has the tag bestseller exactly once",
      "eval": "db.books.findOne({ _id: 8 }).tags",
      "expect": [
        "sf",
        "bestseller"
      ]
    },
    {
      "name": "no book has the tag cyberpunk",
      "eval": "db.books.countDocuments({ tags: 'cyberpunk' })",
      "expect": 0
    },
    {
      "name": "the cyberpunk books keep their other tags",
      "eval": "db.books.findOne({ _id: 2 }).tags",
      "expect": [
        "sf"
      ]
    },
    {
      "name": "the view counter was created and is 3",
      "eval": "db.views.findOne({ _id: 'book:8' })",
      "expect": {
        "_id": "book:8",
        "count": 3
      }
    },
    {
      "name": "the book with no stock is deleted",
      "eval": "db.books.findOne({ _id: 7 })",
      "expect": null
    },
    {
      "name": "seven books are left",
      "eval": "db.books.countDocuments({})",
      "expect": 7
    }
  ],
  "hints": [
    "db.books.updateOne({ _id: 1 }, { $inc: { \"stock.shop\": -1 } });",
    "Many documents at once: db.books.updateMany({ tags: \"classic\" }, { $inc: { price: 2 } });",
    "db.books.updateMany({ tags: \"cyberpunk\" }, { $pull: { tags: \"cyberpunk\" } });",
    "db.books.deleteMany({ \"stock.shop\": 0, \"stock.warehouse\": 0 });"
  ]
}
