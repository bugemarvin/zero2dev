{
  "title": "A price table",
  "lesson": "html/03-tables",
  "kind": "web",
  "page": "index.html",
  "checks": [
    {
      "name": "every element is closed, in the right order",
      "valid": true
    },
    {
      "name": "there is one table",
      "select": "table",
      "count": 1
    },
    {
      "name": "the caption says Monthly plans",
      "select": "table > caption",
      "text": "Monthly plans"
    },
    {
      "name": "thead has one row of three column headers",
      "select": "thead > tr > th[scope='col']",
      "count": 3
    },
    {
      "name": "the column headers are Plan, Price, Storage",
      "select": "thead tr",
      "text": "Plan Price Storage"
    },
    {
      "name": "tbody has three rows",
      "select": "tbody > tr",
      "count": 3
    },
    {
      "name": "each data row starts with a row header",
      "select": "tbody > tr > th[scope='row']:first-child",
      "count": 3
    },
    {
      "name": "each data row has two data cells",
      "select": "tbody > tr > td",
      "count": 6
    },
    {
      "name": "the Pro row is right",
      "select": "tbody > tr:nth-child(2)",
      "text": "Pro $12 100 GB"
    },
    {
      "name": "the Team row is right",
      "select": "tbody > tr:nth-child(3)",
      "text": "Team $30 1 TB"
    }
  ],
  "hints": [
    "The order inside <table> is: <caption>, then <thead>, then <tbody>.",
    "A header cell for a column: <th scope=\"col\">Plan</th>. For a row: <th scope=\"row\">Basic</th>.",
    "Each data row is <tr><th scope=\"row\">...</th><td>...</td><td>...</td></tr>."
  ]
}
