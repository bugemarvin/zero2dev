{
  "title": "A notes API",
  "lesson": "php/05-web",
  "kind": "http",
  "lang": "php",
  "edit": [
    "index.php"
  ],
  "start": [
    "php",
    "-S",
    "{host}:{port}",
    "index.php"
  ],
  "start_timeout": 40,
  "timeout": 20,
  "requests": [
    {
      "name": "GET /notes starts as an empty list",
      "path": "/notes",
      "status": 200,
      "json": [],
      "header": {
        "Content-Type": "application/json"
      }
    },
    {
      "name": "POST /notes creates a note and answers 201",
      "method": "POST",
      "path": "/notes",
      "body": {
        "text": "buy milk"
      },
      "status": 201,
      "json": {
        "id": 1,
        "text": "buy milk"
      }
    },
    {
      "name": "the note is still there on the next request",
      "path": "/notes",
      "status": 200,
      "json": [
        {
          "id": 1,
          "text": "buy milk"
        }
      ]
    },
    {
      "name": "the next note gets the next id",
      "method": "POST",
      "path": "/notes",
      "body": {
        "text": "  walk the dog "
      },
      "status": 201,
      "json": {
        "id": 2,
        "text": "walk the dog"
      }
    },
    {
      "name": "POST with an empty text answers 400",
      "method": "POST",
      "path": "/notes",
      "body": {
        "text": "   "
      },
      "status": 400,
      "json": {
        "error": "text is required"
      }
    },
    {
      "name": "POST with invalid JSON answers 400",
      "method": "POST",
      "path": "/notes",
      "raw": "{not json",
      "headers": {
        "Content-Type": "application/json"
      },
      "status": 400,
      "json": {
        "error": "invalid JSON"
      }
    },
    {
      "name": "GET /notes/2 returns one note",
      "path": "/notes/2",
      "status": 200,
      "json": {
        "id": 2,
        "text": "walk the dog"
      }
    },
    {
      "name": "GET /notes/99 answers 404",
      "path": "/notes/99",
      "status": 404,
      "json": {
        "error": "not found"
      }
    },
    {
      "name": "DELETE /notes/1 answers 204",
      "method": "DELETE",
      "path": "/notes/1",
      "status": 204
    },
    {
      "name": "the deleted note is gone",
      "path": "/notes/1",
      "status": 404
    },
    {
      "name": "the list is still a JSON list",
      "path": "/notes",
      "status": 200,
      "json": [
        {
          "id": 2,
          "text": "walk the dog"
        }
      ]
    },
    {
      "name": "a new note does not reuse an id",
      "method": "POST",
      "path": "/notes",
      "body": {
        "text": "third"
      },
      "status": 201,
      "json": {
        "id": 3,
        "text": "third"
      }
    },
    {
      "name": "an unknown path answers 404",
      "path": "/nothing",
      "status": 404,
      "json": {
        "error": "not found"
      }
    }
  ],
  "hints": [
    "Nothing survives between requests: load the notes from the file at the start of every request, and save after every change.",
    "Keep the next id in the file too, for example ['next' => 3, 'notes' => [...]], so a deleted id is never reused.",
    "A path with an id: if (preg_match('#^/notes/(\\d+)$#', $path, $m)) { $id = (int) $m[1]; ... }",
    "After removing a note, use array_values so the notes are encoded as a JSON list, not an object."
  ]
}
